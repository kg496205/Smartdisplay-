<?xml version="1.0" encoding="UTF-8"?>
<project version="1.0">
  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="facing" val="east"/>
      <a name="tristate" val="false"/>
      <a name="label" val=""/>
      <a name="labelloc" val="west"/>
      <a name="labelfont" val="SansSerif plain 12"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
  </options>
  <mappings/>
  <toolbar/>
  <circuit name="main">
    <comp lib="0" name="Text" loc="(80,40)">
      <a name="text" val="555 TIMER PCB — reconstructed from Eagle board XML"/>
      <a name="font" val="SansSerif bold 16"/>
    </comp>
    <comp lib="0" name="Text" loc="(80,80)">
      <a name="text" val="This is a netlist reference only; analog 555 operation is not simulated."/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(80,125)">
      <a name="text" val="SUPPLY / CONNECTOR JP1"/>
      <a name="font" val="SansSerif bold 13"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,155)">
      <a name="text" val="JP1 pin 1: GND (board net JP1_GND)"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,180)">
      <a name="text" val="JP1 pin 4: VCC (board net JP1_VCC)"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(80,225)">
      <a name="text" val="LM555 (U1) — PCB contact-reference connections"/>
      <a name="font" val="SansSerif bold 13"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,255)">
      <a name="text" val="Pin 1 GND  → JP1_GND"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,280)">
      <a name="text" val="Pin 2 TRIG → U1_TR"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,305)">
      <a name="text" val="Pin 3 OUT  → U1_OUT → PIEZO1 pin 1"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,330)">
      <a name="text" val="Pin 4 RESET → JP1_VCC"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,355)">
      <a name="text" val="Pin 5 CTRL  → U1_TR (same net as pin 2 per PCB XML)"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,380)">
      <a name="text" val="Pin 6 THRESH → U1_THR → C8 pin 2"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,405)">
      <a name="text" val="Pin 7 DISCH → U1_DIS → R3 pin 2, RPOT1 pin 1"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,430)">
      <a name="text" val="Pin 8 VCC   → U1_V+ → R3 pin 1"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(80,475)">
      <a name="text" val="OTHER COMPONENTS / NETS"/>
      <a name="font" val="SansSerif bold 13"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,505)">
      <a name="text" val="C7 10 nF: pin 1 → GND; pin 2 → U1_TR"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,530)">
      <a name="text" val="C8 100 nF: pin 1 → GND; pin 2 → U1_THR"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,555)">
      <a name="text" val="RPOT1 100 kΩ: pin 1 → U1_DIS; pin 2 → U1_TR"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,580)">
      <a name="text" val="R3 1 kΩ: pin 1 → U1_V+; pin 2 → U1_DIS"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,605)">
      <a name="text" val="PIEZO1: pin 1 → U1_OUT; pin 2 → GND"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(80,650)">
      <a name="text" val="CHECK BEFORE BUILDING"/>
      <a name="font" val="SansSerif bold 13"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,680)">
      <a name="text" val="The board file contains PCB nets, not the original schematic."/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,705)">
      <a name="text" val="Pin 2 and pin 5 are joined; this is unusual. Verify against the"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,730)">
      <a name="text" val="intended 555 circuit before powering it. Component pad numbering"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="0" name="Text" loc="(100,755)">
      <a name="text" val="is taken from the uploaded board XML, not independently verified."/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
  </circuit>
</project>
